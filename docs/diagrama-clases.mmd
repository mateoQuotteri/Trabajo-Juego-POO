%% Diagrama de clases del CÓDIGO ACTUAL (16/10/2026, alineado al documento).
%% Pegar en https://mermaid.live (o en mermaid.ai, donde está el oficial).
%% La cátedra pide que los diagramas coincidan con la implementación.
classDiagram
    direction TB

    class Combatiente {
        <<abstract>>
        -String nombre
        -int vidaMaxima
        -int vidaActual
        -int defensa
        -int velocidad
        +recibirDanio(int danio)
        +recibirCuracion(int cantidad)
        +estaVivo() boolean
    }

    class Personaje {
        <<abstract>>
        -int manaMaximo
        -int manaActual
        -int ataqueFisico
        -int ataqueMagico
        -int nivel
        -int experiencia
        -Habilidad habilidadBasica
        -Habilidad habilidadPoderosa
        -boolean defendiendo
        -boolean aturdido
        -int turnosVenenoRestantes
        +atacar(Combatiente objetivo) String
        +tieneManaPara(Habilidad h) boolean
        +usarHabilidad(Habilidad h, Combatiente objetivo) String
        +puedeDefender() boolean
        +defender() String
        +iniciarTurno()
        +crecerManaPorTurno()
        +actualizarEfectosDeFinDeTurno() String
        +prepararParaNuevaBatalla()
        +aturdir()
        +consumirAturdimiento() boolean
        +envenenar()
        +ganarExperiencia(int cantidad) int
        +getAtaque(boolean esMagico) int
        +getNombreClase()* String
    }

    class Guerrero {
        +puedeDefender() boolean
    }
    class Mago
    class Arquero
    class Curador

    class Habilidad {
        <<abstract>>
        -String nombre
        -int costoMana
        +ejecutar(Personaje usuario, Combatiente objetivo)* String
        +esDeApoyo() boolean
        +puedeApuntarA(Combatiente objetivo) boolean
        #calcularDanioBase(Personaje u, Combatiente o, boolean magico) int
    }
    class AtaqueConMultiplicador {
        -double multiplicador
        -boolean esMagico
    }
    class Curacion {
        -int cantidad
    }

    class Enemigo {
        <<abstract>>
        -int ataque
        -int nivel
        -int experienciaQueOtorga
        +actuar(Personaje objetivo)* String
        +atacar(Combatiente objetivo) String
        +esJefe() boolean
        +aplicarEscaladoDePiso(int piso)
        #elegirAccionPonderada(String[] acciones) String
        #ejecutarAccionSobre(String accion, Personaje objetivo) String
    }
    class Slime
    class Goblin
    class Jefe
    class JefeFinal

    class Party {
        -Personaje[] miembros
        -int cantidad
        +agregarMiembro(Personaje p) boolean
        +tieneMiembrosSuficientes() boolean
        +getMiembrosVivos() Personaje[]
        +elegirVivoAlAzar() Personaje
        +estaDerrotada() boolean
        +prepararParaBatalla()
        +repartirExperiencia(int exp) String
    }

    class Batalla {
        -Party party
        -Enemigo enemigo
        -int piso
        -Combatiente[] ordenDeLaRonda
        -int indiceTurnoActual
        -int numeroRonda
        +getCombatienteActual() Combatiente
        +esTurnoDelEnemigo() boolean
        +getPersonajeEnTurno() Personaje
        +terminarTurnoActual()
        +estaTerminada() boolean
        +ganoLaParty() boolean
        -iniciarNuevaRonda()
        -ordenarPorVelocidad(Combatiente[] orden)
    }

    class Partida {
        -Party party
        -int pisoActual
        -boolean ganada
        -boolean perdida
        +crearNueva()$ Partida
        +registrarVictoria()
        +registrarDerrota()
        +estaTerminada() boolean
    }

    class ResultadoDeBatalla {
        -int piso
        -String nombreEnemigo
        -boolean ganoLaParty
        -int experienciaGanada
        -String subidasDeNivel
        -int rondasJugadas
    }

    class GeneradorDeEnemigos {
        +crearEnemigoParaPiso(int piso) Enemigo
    }

    class ControladorDeJuego {
        -Partida partida
        -ControladorDeBatalla controladorDeBatalla
        +nuevaPartida()
        +empezarBatallaDelPisoActual() String
        +cerrarBatalla() ResultadoDeBatalla
    }

    class ControladorDeBatalla {
        -Batalla batalla
        -GeneradorDeEnemigos generador
        -ResultadoDeBatalla resultado
        +iniciarBatalla(Party party, int piso) String
        +atacar() String
        +usarHabilidad(boolean poderosa, Personaje aliado) String
        +defender() String
        +getPersonajeEnTurno() Personaje
        +puedeUsarHabilidad(boolean poderosa) boolean
    }

    class VentanaPrincipal
    class PantallaMenu
    class PantallaPartidasGuardadas
    class PantallaBatalla
    class PantallaResumenBatalla
    class PantallaInventario
    class JuegoConsola

    Combatiente <|-- Personaje
    Combatiente <|-- Enemigo
    Personaje <|-- Guerrero
    Personaje <|-- Mago
    Personaje <|-- Arquero
    Personaje <|-- Curador
    Enemigo <|-- Slime
    Enemigo <|-- Goblin
    Enemigo <|-- Jefe
    Enemigo <|-- JefeFinal
    Habilidad <|-- AtaqueConMultiplicador
    Habilidad <|-- Curacion

    Personaje "1" o-- "2" Habilidad : tiene
    Party "1" o-- "2..4" Personaje : miembros
    Partida --> "1" Party
    Batalla --> "1" Party
    Batalla --> "1" Enemigo
    GeneradorDeEnemigos ..> Enemigo : crea
    ControladorDeBatalla --> Batalla
    ControladorDeBatalla --> GeneradorDeEnemigos
    ControladorDeBatalla ..> ResultadoDeBatalla : crea
    ControladorDeJuego --> Partida
    ControladorDeJuego --> ControladorDeBatalla
    VentanaPrincipal --> ControladorDeJuego
    VentanaPrincipal *-- PantallaMenu
    VentanaPrincipal *-- PantallaPartidasGuardadas
    VentanaPrincipal *-- PantallaBatalla
    VentanaPrincipal *-- PantallaResumenBatalla
    VentanaPrincipal *-- PantallaInventario
    PantallaBatalla --> ControladorDeBatalla : avisa acciones
    JuegoConsola --> ControladorDeJuego : avisa acciones
